# ========================================================
# TMLogistx Central Server Environment Configuration (.env.example)
# ========================================================

PORT=5000
NODE_ENV=development

# Neon PostgreSQL Database Connection String
DATABASE_URL=postgresql://neondb_owner:YOUR_PASSWORD@ep-YOUR-ENDPOINT.eu-central-1.aws.neon.tech/tmlogistx?sslmode=require

# JWT Authentication
JWT_SECRET=your_super_secret_jwt_key_here
JWT_EXPIRES_IN=7d

# Google Maps API Key
GOOGLE_MAPS_API_KEY=your_google_maps_api_key_here

# Mapbox (geocoding & driving directions on server)
MAPBOX_ACCESS_TOKEN=your_mapbox_public_token_pk

# CORS — comma-separated browser origins (your deployed web app URL(s))
# Local dev defaults apply when unset and NODE_ENV is not production.
CORS_ORIGIN=http://localhost:5173,http://localhost:3000,http://localhost:8081

# Mobile / installable app (React Native) — API calls usually have NO Origin header; keep true on Render.
CORS_ALLOW_NO_ORIGIN=true

# Expo Go dev client (exp://...)
CORS_ALLOW_EXPO=true

# Allow phone-on-LAN + localhost patterns in development only
CORS_DEV_LAN=true

# Dev only: allow every origin (never set true in production)
# CORS_ALLOW_ALL=false

PUBLIC_API_URL=https://tmlogistx.onrender.com
# Include your deployed web URL(s) plus localhost for local Vite dev
# CORS_ORIGIN=http://localhost:5173,https://tmlogistx.onrender.com,https://your-web-app.example.com

# Fleet Tracking Settings
GPS_STALE_THRESHOLD_MINUTES=5
DEFAULT_CURRENCY=ETB
AUTO_DISPATCH_ENABLED=false

# Public web app URL (password reset links in Brevo emails)
WEB_APP_URL=http://localhost:5173

# Brevo (Sendinblue) transactional email — replace with your real API key
BREVO_API_KEY=xkeysib-demo-replace-with-real-brevo-api-key
BREVO_SENDER_EMAIL=noreply@your-verified-domain.com
BREVO_SENDER_NAME=TMLogistx

# Cloudinary profile photos (staff / drivers) — replace with your real credentials
CLOUDINARY_CLOUD_NAME=demo_cloud_name
CLOUDINARY_API_KEY=123456789012345
CLOUDINARY_API_SECRET=demo_secret_replace_me
# Optional unsigned upload preset (if set, API secret upload is skipped)
CLOUDINARY_UPLOAD_PRESET=tmlogistx_profiles
