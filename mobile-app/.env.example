# ========================================================
# TMLogistx Mobile App Environment Template (.env.example)
# ========================================================

# Local dev on phone (same Wi‑Fi): http://YOUR_PC_LAN_IP:5000/api
EXPO_PUBLIC_API_BASE_URL=https://tmlogistx.onrender.com/api
EXPO_PUBLIC_SOCKET_URL=https://tmlogistx.onrender.com
EXPO_PUBLIC_MAPBOX_ACCESS_TOKEN=your_mapbox_public_token_pk
EXPO_PUBLIC_MAPBOX_STYLE=mapbox/streets-v12
EXPO_PUBLIC_GOOGLE_MAPS_API_KEY=your_google_maps_key_here
EXPO_PUBLIC_APP_NAME=TMLogistx Mobile
EXPO_PUBLIC_DEFAULT_LANGUAGE=en
EXPO_PUBLIC_GPS_UPDATE_INTERVAL_MS=10000
