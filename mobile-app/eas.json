{
  "cli": {
    "version": ">= 12.0.0",
    "appVersionSource": "local"
  },
  "build": {
    "development": {
      "developmentClient": true,
      "distribution": "internal",
      "android": {
        "buildType": "apk"
      }
    },
    "preview": {
      "distribution": "internal",
      "android": {
        "buildType": "apk"
      },
      "env": {
        "EXPO_PUBLIC_API_BASE_URL": "https://tmlogistx.onrender.com/api",
        "EXPO_PUBLIC_SOCKET_URL": "https://tmlogistx.onrender.com",
        "EXPO_PUBLIC_APP_NAME": "TMLogistx Mobile",
        "EXPO_PUBLIC_DEFAULT_LANGUAGE": "en",
        "EXPO_PUBLIC_GPS_UPDATE_INTERVAL_MS": "10000"
      }
    },
    "production": {
      "autoIncrement": true,
      "android": {
        "buildType": "app-bundle"
      },
      "env": {
        "EXPO_PUBLIC_API_BASE_URL": "https://tmlogistx.onrender.com/api",
        "EXPO_PUBLIC_SOCKET_URL": "https://tmlogistx.onrender.com"
      }
    }
  },
  "submit": {
    "production": {}
  }
}
