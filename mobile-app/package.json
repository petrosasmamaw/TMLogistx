{
  "name": "tmlogistx-mobile",
  "version": "1.0.0",
  "description": "TMLogistx - Staff Movement & Fleet Management Mobile App (React Native / Expo with Bilingual EN/AM)",
  "main": "index.js",
  "scripts": {
    "start": "expo start",
    "dev": "expo start --web --clear",
    "reload": "node scripts/reload-web.mjs",
    "android": "expo start --android",
    "ios": "expo start --ios",
    "web": "expo start --web",
    "test": "node test-mobile.js",
    "build:android:preview": "eas build --platform android --profile preview",
    "build:android:production": "eas build --platform android --profile production",
    "build:status": "eas build:list --platform android --limit 5",
    "generate:brand": "node scripts/generate-brand-assets.mjs"
  },
  "dependencies": {
    "@expo/metro-runtime": "~3.2.3",
    "@react-native-async-storage/async-storage": "^1.23.1",
    "@reduxjs/toolkit": "^2.2.3",
    "expo": "~51.0.0",
    "expo-image-picker": "~15.0.7",
    "expo-linking": "~6.3.1",
    "expo-location": "~17.0.1",
    "expo-notifications": "^0.28.19",
    "expo-status-bar": "~1.12.1",
    "expo-task-manager": "~11.8.2",
    "react": "18.2.0",
    "react-dom": "18.2.0",
    "react-native": "0.74.5",
    "react-native-safe-area-context": "4.10.5",
    "react-native-web": "~0.19.10",
    "react-native-webview": "13.8.6",
    "react-redux": "^9.1.0",
    "socket.io-client": "^4.8.4"
  },
  "devDependencies": {
    "@babel/core": "^7.20.0",
    "@resvg/resvg-js": "^2.6.2",
    "eas-cli": "^16.0.0",
    "sharp": "^0.33.5"
  },
  "private": true
}
