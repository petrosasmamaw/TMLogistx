{
  "name": "tmlogistx-mobile",
  "version": "1.0.0",
  "description": "TMLogistx - Staff Movement & Fleet Management Mobile App (React Native / Expo with Bilingual EN/AM)",
  "main": "index.js",
  "scripts": {
    "start": "node scripts/start-expo.mjs",
    "dev": "node scripts/start-expo.mjs",
    "dev:tunnel": "node scripts/start-expo.mjs --tunnel",
    "dev:web": "node scripts/free-metro-port.mjs && expo start --web --clear --port 8081",
    "reload": "node scripts/reload-web.mjs",
    "android": "expo start --android --lan",
    "ios": "expo start --ios --lan",
    "web": "node scripts/free-metro-port.mjs && expo start --web --port 8081",
    "test": "node test-mobile.js",
    "test:manual-location": "node scripts/test-manual-location-distance.mjs",
    "test:trip-rules": "node scripts/test-trip-location-rules.mjs",
    "embed:markers": "node scripts/embed-map-markers.mjs",
    "prebuild:android:preview": "npm run embed:markers && eas build --platform android --profile preview",
    "build:android:preview": "eas build --platform android --profile preview",
    "build:android:production": "eas build --platform android --profile production",
    "build:status": "eas build:list --platform android --limit 5",
    "generate:brand": "node scripts/generate-brand-assets.mjs"
  },
  "dependencies": {
    "@expo-google-fonts/plus-jakarta-sans": "^0.4.2",
    "@expo/metro-runtime": "~57.0.17",
    "@expo/vector-icons": "^15.0.2",
    "@react-native-async-storage/async-storage": "2.2.0",
    "@reduxjs/toolkit": "^2.2.3",
    "expo": "~57.0.31",
    "expo-application": "~57.0.3",
    "expo-asset": "~57.0.20",
    "expo-constants": "~57.0.22",
    "expo-font": "~57.0.4",
    "expo-image-picker": "~57.0.20",
    "expo-intent-launcher": "~57.0.1",
    "expo-linking": "~57.0.13",
    "expo-location": "~57.0.22",
    "expo-notifications": "~57.0.24",
    "expo-status-bar": "~57.0.1",
    "expo-task-manager": "~57.0.21",
    "react": "19.2.3",
    "react-dom": "19.2.3",
    "react-native": "0.86.3",
    "react-native-safe-area-context": "~5.7.0",
    "react-native-screens": "~4.26.0",
    "react-native-web": "^0.21.2",
    "react-native-webview": "13.16.1",
    "react-redux": "^9.1.0",
    "socket.io-client": "^4.8.4"
  },
  "devDependencies": {
    "@babel/core": "^7.20.0",
    "@resvg/resvg-js": "^2.6.2",
    "eas-cli": "^16.0.0",
    "sharp": "^0.33.5"
  },
  "private": true
}
